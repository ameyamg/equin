#!/bin/sh
set -e
cd "$(dirname "$0")"

# `push` rebases onto local main FIRST, before anything else here or in Bun
# runs, so the push runs main's code rather than this branch's older copy
# (cli/push CLAUDE.md, § Rebase first). Git and sh only, and it says why when
# it refuses, so it cannot fail silently. Once rebased, the rebased `./equin`
# runs the push, installing the rebased lockfile as it stands (frozen, as the
# land phase does: a mid-push tree is never re-resolved). Not for the land
# phase, which is a push's own child.
# Kept first in this file: the `push:rebase-first-stub` check holds it there.
if [ "${1:-}" = push ] && [ -z "${EQUIN_PUSH_LAND:-}" ]; then
  first=0
  sh plugins/framework/plugins/cli/plugins/push/scripts/rebase-first.sh "$@" || first=$?
  case $first in
    0) ;;
    10) export EQUIN_FROZEN_LOCKFILE=1 && exec ./equin "$@" ;;
    *) exit "$first" ;;
  esac
fi

command -v bun >/dev/null 2>&1 || {
  echo "equin: bun not found — nothing can run without it." >&2
  sh plugins/framework/plugins/cli/plugins/doctor/doctor.sh >&2
  exit 1
}
# The data root, decided once for the whole process tree (infra/paths CLAUDE.md,
# § The data root). Conditionals only, like the naming below: it cannot abort.
if [ -f plugins/infra/plugins/paths/scripts/declare-data-root.sh ]; then
  . plugins/infra/plugins/paths/scripts/declare-data-root.sh
fi
# The process's name in Activity Monitor: `equin · <verb>`, not `bun`
# (packages/process-name). Run through an APFS clone of the checkout's Bun in
# `verbs` — a symlink the CLI points at the machine-wide clones of that Bun
# version, so each verb's name is made (and scanned by macOS, ~1 s on its first
# exec) once per machine, not once per checkout. The CLI records the checkout's
# Bun (it knows the real binary behind mise's shim), trusted only while its stamp
# is newer than mise.lock. A clone, never a hardlink: macOS SIGKILLs an exec
# whose inode it resolves to a deleted name (process-name's CLAUDE.md). A clone
# keeps the source's mtime, so the name is current while it is not the same file
# as `bun` and neither is newer — re-cloned only then.
# Builtins plus `cp`: on any miss — none recorded, a toolchain change, a
# refused clone — it is the plain `bun` below, and that run records it again.
names=node_modules/.cache/equin-bun
case "${1:-}" in
  "" | *[!a-z0-9-]*) verb=cli ;;
  *) verb=$1 ;;
esac
named="$names/verbs/equin · $verb"
# A check pass's heap is paced (heap-pacing: CHECK_PROCESS_RAM_BYTES, marked as
# this repo's by EQUIN_HEAP_PACED), as its build or push child is: JSC reads it
# once, at VM start, so it is set before the exec. A pace a person set (no
# mark) wins; one this repo set for a parent is replaced, as pacedHeapEnv does.
# Conditionals only: it cannot abort.
if [ "$verb" = check ] &&
  { [ -z "${BUN_JSC_forceRAMSize:-}" ] || [ -n "${EQUIN_HEAP_PACED:-}" ]; }; then
  export BUN_JSC_forceRAMSize=2000000000 EQUIN_HEAP_PACED=1
fi
if [ -f "$names/bun" ] && [ -d "$names/verbs" ] && [ "$names/stamp" -nt mise.lock ]; then
  if { [ -f "$named" ] && ! [ "$named" -ef "$names/bun" ] &&
    ! [ "$named" -nt "$names/bun" ] && ! [ "$names/bun" -nt "$named" ]; } ||
    { cp -c "$names/bun" "$named.$$" 2>/dev/null && mv -f "$named.$$" "$named"; }; then
    exec "$named" plugins/framework/plugins/cli/bin/index.ts "$@"
  fi
  rm -f "$named.$$"
fi
exec bun plugins/framework/plugins/cli/bin/index.ts "$@"
