    {
      "id": "proposed",
      "name": "Proposed",
      "icon": "inbox",
      "view": {
        "type": "table",
        "sort": { "fieldId": "createdAt", "direction": "desc" }
      }
    }
  ],
  "sortPresets": [],
  "filterPresets": [],
  "customColumns": []
}
