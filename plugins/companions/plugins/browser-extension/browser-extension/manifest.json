{
  "manifest_version": 3,
  "name": "equin",
  "description": "equin from any tab: send a wish, jump between equin.ai and your own equin, run the actions your apps offer on the page, and record the tab to a video.",
  "version": "1.0.0",
  "action": {
    "default_title": "equin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*.localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Record this tab, or stop recording"
    }
  }
}
